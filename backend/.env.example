# Copy this file to ".env" for local work. NEVER commit ".env" and never paste real secrets into this example.
# On Render, set these same names in the service's Environment tab instead of using a file.

PORT=5000
NODE_ENV=development            # set to "production" on Render

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Example shape only:
# mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/coalguard?retryWrites=true&w=majority
# Local development ONLY: leave empty to use the JSON file backend/data/db.json instead.
MONGODB_URI=

# Long random text, 32+ characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Websites allowed to call this API (comma separated, * wildcard allowed). Use your Vercel address:
# CORS_ORIGINS=https://your-site.vercel.app
CORS_ORIGINS=

# Creates the three demo accounts and sample mines the first time the database is empty. Use "false" to turn off.
SEED_DEMO_DATA=true

# Safety thresholds used by the rule-based compliance engine
METHANE_WARN=0.75
METHANE_CRIT=1.25
PM10_WARN=100
PM10_CRIT=250
TEMP_WARN=37
PPE_MIN=90
